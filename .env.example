# ==============================================================================
# NANO ROUTE — APPLICATION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT SECURITY POLICY:
# 1. NEVER commit actual API keys, secrets, or credentials to this file or any .env file.
# 2. Frontend code NEVER receives raw AI provider keys (OpenAI, Anthropic, Gemini, Groq, etc.).
# 3. Provider credentials are encrypted at rest using Windows DPAPI in the Rust native core.
# 4. Only variables prefixed with VITE_ are exposed to the React frontend bundle.
# ==============================================================================

# Application Environment Mode (development | test | production)
VITE_APP_ENV=development

# Application Build / Display Version
VITE_APP_VERSION=0.1.0

# Optional Public Feature Toggles (Client-side presentation only)
VITE_ENABLE_DEBUG_OVERLAY=false
VITE_ENABLE_VERBOSE_UI_LOGGING=false

